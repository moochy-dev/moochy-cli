{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moochy",
  "version": "0.1.8",
  "identifier": "dev.moochy.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moochy",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg"],
    "category": "Utility",
    "shortDescription": "Donate tokens to open source",
    "longDescription": "The Moochy desktop app: donate your LLM tokens to open-source projects, with a monthly limit for this computer. Your key never leaves your machine.",
    "license": "Apache-2.0",
    "homepage": "https://moochy.dev",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "externalBin": ["bin/moochy"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
