# Copy to .env and edit.

# Dollars a month this machine may spend. Setting it confirms that you set a
# spend limit at your provider, or that you accept the risk.
MOOCHY_MONTHLY_LIMIT=25

# Profile api: anthropic, openai, openrouter, deepseek or xai.
MOOCHY_PROVIDER=anthropic

# Optional: donate to a project (owner/name) up to this many dollars a month.
# The node donates once; `moochy donations` shows it.
MOOCHY_DONATE=
MOOCHY_DONATE_CAP=

# Profile gpu: the Ollama model, and its public id for projects (local/...).
OLLAMA_MODEL=qwen2.5:7b
MOOCHY_LOCAL_MODEL=local/qwen2.5-7b-q4

# Pin a release instead of latest, e.g. v0.1.8 (the release tag).
MOOCHY_VERSION=latest
